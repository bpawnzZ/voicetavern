{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceTavern",
  "version": "1.0.0",
  "identifier": "com.voicetavern.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoiceTavern",
        "width": 1100,
        "height": 760,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Entertainment",
    "shortDescription": "Real-time voice chat frontend for SillyTavern character cards",
    "longDescription": "A modern, ultra-low latency real-time voice chat frontend for SillyTavern character cards powered by multi-provider Realtime Speech-to-Speech models."
  }
}
